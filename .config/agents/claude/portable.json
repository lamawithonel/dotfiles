  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/home/lucas/.claude/hooks/lint-shell.sh",
            "statusMessage": "Linting shell script...",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ]
  },
