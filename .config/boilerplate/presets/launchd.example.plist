<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ~/.config/boilerplate/presets/launchd.example.plist -->
<!-- macOS LaunchAgent user property list template -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.{{organization}}.{{project_name}}</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/{{project_name}}</string>
        <string>daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>~/Library/Logs/{{project_name}}/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>~/Library/Logs/{{project_name}}/stderr.log</string>
</dict>
</plist>
