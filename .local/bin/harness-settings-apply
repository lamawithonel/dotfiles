#!/bin/sh
#
# harness-settings-apply -- apply declarative portable config onto
# live agent settings files.
#
# Usage:
#	harness-settings-apply [--check] [TOOL ...]
#
# TOOL is `claude`, `pi`, or `srt`; default is all three, in that
# order.  With --check, report drift as a unified diff and exit 1
# instead of writing.
#
# The srt target chains off the claude one: portable.json merges
# into ~/.claude/settings.json, then that merged file's `sandbox`
# object (minus the Claude-Code-only autoAllowBashIfSandboxed and
# failIfUnavailable keys) becomes the patch for ~/.srt-settings.json,
# which Pi reads through the ~/.pi/agent/sandbox.json symlink.  Order in
# the default list matters: claude must reconcile before srt so srt sees
# the fresh merge.
#
# Host-local overlay: an optional, untracked
# ~/.config/agents/<tool>/portable.local.json (the `?*.local.*` pattern
# in the yadm .gitignore keeps it out of the repository) layers over
# the tool's portable.json BEFORE the merge.  Arrays union, portable
# entries first, then overlay entries, duplicates dropped; objects merge
# recursively; any other overlay value wins.  Without the overlay, an
# array that portable.json declares replaces the live one whole and
# deletes host-local entries.  A missing overlay changes nothing; an
# overlay that is not a JSON object fails the run.  The srt patch
# derives from the merged claude file, so it carries the overlay too.
#
# Semantics: RFC 7386 JSON Merge Patch.  Keys declared in the tool's
# portable.json are authoritative -- objects merge recursively, arrays
# replace whole, and an explicit null deletes the key from the target.
# Keys NOT declared pass through untouched, so host-local config and
# state written by the tools at runtime both survive.  Output is
# `jq -S` normalized, writes are atomic (same-directory temp + mv),
# and a write is skipped entirely when nothing would change, so repeat
# runs -- including from yadm hooks -- are safe no-ops.

set -o errexit
set -o nounset

PROG="${0##*/}"
CONFIG_DIR="${HOME}/.config/agents"
readonly PROG CONFIG_DIR

# shellcheck disable=SC2016  # $k and $patch are jq variables, not shell
MERGE_FILTER='
def mergepatch(patch):
	if (patch | type) == "object" then
		(if type == "object" then . else {} end)
		| reduce (patch | keys_unsorted[]) as $k (.;
			if patch[$k] == null then
				del(.[$k])
			else
				.[$k] = (.[$k] | mergepatch(patch[$k]))
			end)
	else
		patch
	end;
mergepatch($patch[0])
'
readonly MERGE_FILTER

# Layer an overlay ($overlay[0]) over a base document: arrays union in
# order without duplicates, objects recurse, anything else is replaced.
# shellcheck disable=SC2016  # $o and $x are jq variables, not shell
OVERLAY_FILTER='
def dedupe:
	reduce .[] as $x ([]; if index([$x]) then . else . + [$x] end);
def layer($o):
	if type == "object" and ($o | type) == "object" then
		reduce ($o | keys_unsorted[]) as $k (.;
			.[$k] = (if has($k) then (.[$k] | layer($o[$k])) else $o[$k] end))
	elif type == "array" and ($o | type) == "array" then
		(. + $o) | dedupe
	else
		$o
	end;
layer($overlay[0])
'
readonly OVERLAY_FILTER

_target_for() {
	case "$1" in
		claude) printf '%s\n' "${HOME}/.claude/settings.json" ;;
		pi) printf '%s\n' "${HOME}/.pi/agent/settings.json" ;;
		srt) printf '%s\n' "${HOME}/.srt-settings.json" ;;
		*)
			printf '%s: unknown tool: %s\n' "$PROG" "$1" >&2
			return 2
			;;
	esac
}

# Print the path of the merge patch for a tool, or nothing to skip.
# claude/pi patch from their portable.json; srt derives its patch
# from the already-merged claude settings file.
_patch_for() {
	case "$1" in
		srt)
			_src="${HOME}/.claude/settings.json"
			[ -f "${_src}" ] || return 0
			_derived="${_workdir}/srt.patch.json"
			if jq -e '.sandbox
					| select(type == "object")
					| del(.autoAllowBashIfSandboxed, .failIfUnavailable)' \
				"${_src}" > "${_derived}" 2> /dev/null; then
				printf '%s\n' "${_derived}"
			fi
			;;
		*)
			_p="${CONFIG_DIR}/$1/portable.json"
			[ -f "${_p}" ] || return 0
			_o="${CONFIG_DIR}/$1/portable.local.json"
			if [ -f "${_o}" ]; then
				_layered="${_workdir}/$1.layered.json"
				jq -e 'type == "object"' "${_o}" > /dev/null
				jq -S --slurpfile overlay "${_o}" "${OVERLAY_FILTER}" "${_p}" \
					> "${_layered}"
				_p="${_layered}"
			fi
			printf '%s\n' "${_p}"
			;;
	esac
	return 0
}

_reconcile_one() {
	_tool="$1"
	_mode="$2"
	_target="$(_target_for "${_tool}")"
	_patch="$(_patch_for "${_tool}")"

	if [ -z "${_patch}" ]; then
		printf '%s: %s: no source config, skipping\n' "$PROG" "${_tool}" >&2
		return 0
	fi

	_current="${_workdir}/${_tool}.current.json"
	_merged="${_workdir}/${_tool}.merged.json"
	if [ -f "${_target}" ]; then
		jq -S . "${_target}" > "${_current}"
	else
		printf '{}\n' > "${_current}"
	fi
	jq -S --slurpfile patch "${_patch}" "${MERGE_FILTER}" \
		"${_current}" > "${_merged}"

	if cmp -s "${_current}" "${_merged}"; then
		printf '%s: %s: in sync\n' "$PROG" "${_tool}"
		return 0
	fi

	if [ "${_mode}" = 'check' ]; then
		printf '%s: %s: drift\n' "$PROG" "${_tool}"
		diff -u "${_current}" "${_merged}" || true
		return 1
	fi

	mkdir -p "$(dirname "${_target}")"
	_staged="$(mktemp "${_target}.XXXXXX")"
	if ! { cp "${_merged}" "${_staged}" && mv "${_staged}" "${_target}"; }; then
		rm -f "${_staged}"
		printf '%s: %s: write failed: %s\n' \
			"$PROG" "${_tool}" "${_target}" >&2
		return 1
	fi
	printf '%s: %s: applied\n' "$PROG" "${_tool}"
}

main() {
	_mode='apply'
	if [ "${1:-}" = '--check' ]; then
		_mode='check'
		shift
	fi
	[ "$#" -gt 0 ] || set -- claude pi srt

	_workdir="$(mktemp -d "${TMPDIR:-/tmp}/agents-config.XXXXXX")"
	trap 'rm -rf "${_workdir}"' EXIT

	_rc=0
	for _t in "$@"; do
		# A function called on the left of `||` runs with errexit off,
		# so a failed step would fall through to "applied".  Run each
		# tool in a subshell outside any AND-OR list instead: errexit
		# stays on inside it, and the first failed step stops that tool.
		set +o errexit
		(
			set -o errexit
			_reconcile_one "${_t}" "${_mode}"
		)
		_status="$?"
		set -o errexit
		[ "${_status}" -eq 0 ] || _rc=1
	done
	return "${_rc}"
}

main "$@"
