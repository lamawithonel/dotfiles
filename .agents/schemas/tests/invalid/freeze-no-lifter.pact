<?xml version="1.0" encoding="UTF-8"?>
<org:freeze xmlns="urn:pact:taxonomy:1.0" xmlns:org="urn:pact:org:1.0"
            version="1.0">
  <org:issuer>agents-config-executive</org:issuer>
  <org:reason>The registry file is being rewritten.</org:reason>
  <org:scope>Every write to /home/lucas/.agents/model-benchmarks.json.</org:scope>
  <org:end>The executive sends a ruling that ends the freeze.</org:end>
  <org:covers-dispatch>false</org:covers-dispatch>
</org:freeze>
